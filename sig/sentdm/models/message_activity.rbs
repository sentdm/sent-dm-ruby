module Sentdm
  module Models
    type message_activity =
      {
        active_contact_price: String?,
        description: String,
        from: String?,
        price: String?,
        reason: String?,
        reason_code: String?,
        scheduled_at: Time?,
        status: String,
        timestamp: Time
      }

    class MessageActivity < Sentdm::Internal::Type::BaseModel
      attr_accessor active_contact_price: String?

      attr_reader description: String?

      def description=: (String) -> String

      attr_accessor from: String?

      attr_accessor price: String?

      attr_accessor reason: String?

      attr_accessor reason_code: String?

      attr_accessor scheduled_at: Time?

      attr_reader status: String?

      def status=: (String) -> String

      attr_reader timestamp: Time?

      def timestamp=: (Time) -> Time

      def initialize: (
        ?active_contact_price: String?,
        ?description: String,
        ?from: String?,
        ?price: String?,
        ?reason: String?,
        ?reason_code: String?,
        ?scheduled_at: Time?,
        ?status: String,
        ?timestamp: Time
      ) -> void

      def to_hash: -> {
        active_contact_price: String?,
        description: String,
        from: String?,
        price: String?,
        reason: String?,
        reason_code: String?,
        scheduled_at: Time?,
        status: String,
        timestamp: Time
      }
    end
  end
end
