module Sentdm
  module Models
    type channel_event_payload =
      {
        country: String,
        account_id: String,
        channel: String,
        compliance: Sentdm::ChannelEventPayload::Compliance?,
        number_type: String?,
        reason: String?,
        reason_code: String?,
        sender_value: String?,
        status: String,
        updated_at: String
      }

    class ChannelEventPayload < Sentdm::Internal::Type::BaseModel
      attr_accessor country: String

      attr_reader account_id: String?

      def account_id=: (String) -> String

      attr_reader channel: String?

      def channel=: (String) -> String

      attr_accessor compliance: Sentdm::ChannelEventPayload::Compliance?

      attr_accessor number_type: String?

      attr_accessor reason: String?

      attr_accessor reason_code: String?

      attr_accessor sender_value: String?

      attr_reader status: String?

      def status=: (String) -> String

      attr_reader updated_at: String?

      def updated_at=: (String) -> String

      def initialize: (
        country: String,
        ?account_id: String,
        ?channel: String,
        ?compliance: Sentdm::ChannelEventPayload::Compliance?,
        ?number_type: String?,
        ?reason: String?,
        ?reason_code: String?,
        ?sender_value: String?,
        ?status: String,
        ?updated_at: String
      ) -> void

      def to_hash: -> {
        country: String,
        account_id: String,
        channel: String,
        compliance: Sentdm::ChannelEventPayload::Compliance?,
        number_type: String?,
        reason: String?,
        reason_code: String?,
        sender_value: String?,
        status: String,
        updated_at: String
      }

      type compliance =
        {
          brand: ::Hash[Symbol, top]?,
          campaign: ::Hash[Symbol, top]?,
          documents: ::Array[Sentdm::ChannelEventPayload::Compliance::Document]?
        }

      class Compliance < Sentdm::Internal::Type::BaseModel
        attr_accessor brand: ::Hash[Symbol, top]?

        attr_accessor campaign: ::Hash[Symbol, top]?

        attr_accessor documents: ::Array[Sentdm::ChannelEventPayload::Compliance::Document]?

        def initialize: (
          ?brand: ::Hash[Symbol, top]?,
          ?campaign: ::Hash[Symbol, top]?,
          ?documents: ::Array[Sentdm::ChannelEventPayload::Compliance::Document]?
        ) -> void

        def to_hash: -> {
          brand: ::Hash[Symbol, top]?,
          campaign: ::Hash[Symbol, top]?,
          documents: ::Array[Sentdm::ChannelEventPayload::Compliance::Document]?
        }

        type document =
          { document_id: String?, file_name: String?, key: String }

        class Document < Sentdm::Internal::Type::BaseModel
          attr_accessor document_id: String?

          attr_accessor file_name: String?

          attr_reader key: String?

          def key=: (String) -> String

          def initialize: (
            ?document_id: String?,
            ?file_name: String?,
            ?key: String
          ) -> void

          def to_hash: -> {
            document_id: String?,
            file_name: String?,
            key: String
          }
        end
      end
    end
  end
end
