module Sentdm
  module Models
    type message_resend_response_data =
      {
        recipients: ::Array[Sentdm::MessageResendResponseData::Recipient],
        status: String,
        template_id: String,
        template_name: String
      }

    class MessageResendResponseData < Sentdm::Internal::Type::BaseModel
      attr_reader recipients: ::Array[Sentdm::MessageResendResponseData::Recipient]?

      def recipients=: (
        ::Array[Sentdm::MessageResendResponseData::Recipient]
      ) -> ::Array[Sentdm::MessageResendResponseData::Recipient]

      attr_reader status: String?

      def status=: (String) -> String

      attr_reader template_id: String?

      def template_id=: (String) -> String

      attr_reader template_name: String?

      def template_name=: (String) -> String

      def initialize: (
        ?recipients: ::Array[Sentdm::MessageResendResponseData::Recipient],
        ?status: String,
        ?template_id: String,
        ?template_name: String
      ) -> void

      def to_hash: -> {
        recipients: ::Array[Sentdm::MessageResendResponseData::Recipient],
        status: String,
        template_id: String,
        template_name: String
      }

      type recipient =
        { body: String?, channel: String?, message_id: String, to: String }

      class Recipient < Sentdm::Internal::Type::BaseModel
        attr_accessor body: String?

        attr_accessor channel: String?

        attr_reader message_id: String?

        def message_id=: (String) -> String

        attr_reader to: String?

        def to=: (String) -> String

        def initialize: (
          ?body: String?,
          ?channel: String?,
          ?message_id: String,
          ?to: String
        ) -> void

        def to_hash: -> {
          body: String?,
          channel: String?,
          message_id: String,
          to: String
        }
      end
    end
  end
end
