module Sentdm
  module Models
    type webhook_test = { message: String, success: bool }

    class WebhookTest < Sentdm::Internal::Type::BaseModel
      attr_reader message: String?

      def message=: (String) -> String

      attr_reader success: bool?

      def success=: (bool) -> bool

      def initialize: (?message: String, ?success: bool) -> void

      def to_hash: -> { message: String, success: bool }
    end
  end
end
