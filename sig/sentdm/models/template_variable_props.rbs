module Sentdm
  module Models
    type template_variable_props =
      {
        media_type: String,
        sample: String,
        url: String,
        variable_type: String,
        alt: String?,
        regex: String?,
        short_url: String?
      }

    class TemplateVariableProps < Sentdm::Internal::Type::BaseModel
      attr_accessor media_type: String

      attr_accessor sample: String

      attr_accessor url: String

      attr_accessor variable_type: String

      attr_accessor alt: String?

      attr_accessor regex: String?

      attr_accessor short_url: String?

      def initialize: (
        media_type: String,
        sample: String,
        url: String,
        variable_type: String,
        ?alt: String?,
        ?regex: String?,
        ?short_url: String?
      ) -> void

      def to_hash: -> {
        media_type: String,
        sample: String,
        url: String,
        variable_type: String,
        alt: String?,
        regex: String?,
        short_url: String?
      }
    end
  end
end
