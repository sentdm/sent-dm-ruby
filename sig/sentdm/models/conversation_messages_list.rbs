module Sentdm
  module Models
    type conversation_messages_list =
      { messages: ::Array[Sentdm::Message], pagination: Sentdm::PaginationMeta }

    class ConversationMessagesList < Sentdm::Internal::Type::BaseModel
      attr_reader messages: ::Array[Sentdm::Message]?

      def messages=: (::Array[Sentdm::Message]) -> ::Array[Sentdm::Message]

      attr_reader pagination: Sentdm::PaginationMeta?

      def pagination=: (Sentdm::PaginationMeta) -> Sentdm::PaginationMeta

      def initialize: (
        ?messages: ::Array[Sentdm::Message],
        ?pagination: Sentdm::PaginationMeta
      ) -> void

      def to_hash: -> {
        messages: ::Array[Sentdm::Message],
        pagination: Sentdm::PaginationMeta
      }
    end
  end
end
