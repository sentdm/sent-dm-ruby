module Sentdm
  module Models
    type compliance_retrieve_requirements_params =
      {
        channel: String?,
        country: String?,
        type: String?,
        x_profile_id: String
      }
      & Sentdm::Internal::Type::request_parameters

    class ComplianceRetrieveRequirementsParams < Sentdm::Internal::Type::BaseModel
      extend Sentdm::Internal::Type::RequestParameters::Converter
      include Sentdm::Internal::Type::RequestParameters

      attr_accessor channel: String?

      attr_accessor country: String?

      attr_accessor type: String?

      attr_reader x_profile_id: String?

      def x_profile_id=: (String) -> String

      def initialize: (
        ?channel: String?,
        ?country: String?,
        ?type: String?,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> void

      def to_hash: -> {
        channel: String?,
        country: String?,
        type: String?,
        x_profile_id: String,
        request_options: Sentdm::RequestOptions
      }
    end
  end
end
