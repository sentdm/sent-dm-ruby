module Sentdm
  module Models
    type webhook_list_events_response =
      {
        id: String,
        created_at: Time,
        delivery_attempts: Integer,
        delivery_status: String,
        error_message: String?,
        event_data: Sentdm::Models::WebhookListEventsResponse::event_data,
        event_type: String,
        http_status_code: Integer?,
        processing_completed_at: Time?,
        processing_started_at: Time?,
        response_body: String?
      }

    class WebhookListEventsResponse < Sentdm::Internal::Type::BaseModel
