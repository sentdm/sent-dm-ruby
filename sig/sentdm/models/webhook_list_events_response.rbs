      def id=: (String) -> String

      attr_reader created_at: Time?

      def created_at=: (Time) -> Time

      attr_reader delivery_attempts: Integer?

      def delivery_attempts=: (Integer) -> Integer

      attr_reader delivery_status: String?

      def delivery_status=: (String) -> String

      attr_accessor error_message: String?

      attr_reader event_data: Sentdm::Models::WebhookListEventsResponse::event_data?

      def event_data=: (
        Sentdm::Models::WebhookListEventsResponse::event_data
      ) -> Sentdm::Models::WebhookListEventsResponse::event_data

      attr_reader event_type: String?

      def event_type=: (String) -> String

      attr_accessor http_status_code: Integer?

      attr_accessor processing_completed_at: Time?

      attr_accessor processing_started_at: Time?

      attr_accessor response_body: String?

      def initialize: (
        ?id: String,
        ?created_at: Time,
        ?delivery_attempts: Integer,
        ?delivery_status: String,
        ?error_message: String?,
        ?event_data: Sentdm::Models::WebhookListEventsResponse::event_data,
        ?event_type: String,
        ?http_status_code: Integer?,
        ?processing_completed_at: Time?,
        ?processing_started_at: Time?,
