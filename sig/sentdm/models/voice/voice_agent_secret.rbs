module Sentdm
  module Models
    class VoiceAgentSecret = Voice::VoiceAgentSecret

    module Voice
      type voice_agent_secret = { signing_secret: String }

      class VoiceAgentSecret < Sentdm::Internal::Type::BaseModel
        attr_reader signing_secret: String?

        def signing_secret=: (String) -> String

        def initialize: (?signing_secret: String) -> void

        def to_hash: -> { signing_secret: String }
      end
    end
  end
end
