module Sentdm
  module Models
    class VoiceAgentLimitsSpec = Voice::VoiceAgentLimitsSpec

    module Voice
      type voice_agent_limits_spec =
        {
          allowed_countries: ::Array[String]?,
          max_call_seconds: Integer?,
          max_concurrent_calls: Integer?
        }

      class VoiceAgentLimitsSpec < Sentdm::Internal::Type::BaseModel
        attr_accessor allowed_countries: ::Array[String]?

        attr_accessor max_call_seconds: Integer?

        attr_accessor max_concurrent_calls: Integer?

        def initialize: (
          ?allowed_countries: ::Array[String]?,
          ?max_call_seconds: Integer?,
          ?max_concurrent_calls: Integer?
        ) -> void

        def to_hash: -> {
          allowed_countries: ::Array[String]?,
          max_call_seconds: Integer?,
          max_concurrent_calls: Integer?
        }
      end
    end
  end
end
