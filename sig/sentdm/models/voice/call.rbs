module Sentdm
  module Models
    module Voice
      type call =
        {
          id: String,
          agent_id: String?,
          answered_at: Time?,
          caller_id_used: String?,
          connected_number: String?,
          direction: String,
          duration_seconds: Integer?,
          ended_at: Time?,
          failure_reason: String?,
          from: Sentdm::Voice::CallParty,
          legs: ::Array[Sentdm::Voice::Call::Leg]?,
          mode: String,
          number: String,
          price: Float?,
          recording_available: bool,
          started_at: Time,
          status: String,
          timeline: ::Array[Sentdm::Voice::CallTimelineEntry]?,
          to: Sentdm::Voice::CallParty
        }

      class Call < Sentdm::Internal::Type::BaseModel
        attr_reader id: String?

        def id=: (String) -> String

        attr_accessor agent_id: String?

        attr_accessor answered_at: Time?

        attr_accessor caller_id_used: String?

        attr_accessor connected_number: String?

        attr_reader direction: String?

        def direction=: (String) -> String

        attr_accessor duration_seconds: Integer?

        attr_accessor ended_at: Time?

        attr_accessor failure_reason: String?

        attr_reader from: Sentdm::Voice::CallParty?

        def from=: (Sentdm::Voice::CallParty) -> Sentdm::Voice::CallParty

        attr_accessor legs: ::Array[Sentdm::Voice::Call::Leg]?

        attr_reader mode: String?

        def mode=: (String) -> String

        attr_reader number: String?

        def number=: (String) -> String

        attr_accessor price: Float?

        attr_reader recording_available: bool?

        def recording_available=: (bool) -> bool

        attr_reader started_at: Time?

        def started_at=: (Time) -> Time

        attr_reader status: String?

        def status=: (String) -> String

        attr_accessor timeline: ::Array[Sentdm::Voice::CallTimelineEntry]?

        attr_reader to: Sentdm::Voice::CallParty?

        def to=: (Sentdm::Voice::CallParty) -> Sentdm::Voice::CallParty

        def initialize: (
          ?id: String,
          ?agent_id: String?,
          ?answered_at: Time?,
          ?caller_id_used: String?,
          ?connected_number: String?,
          ?direction: String,
          ?duration_seconds: Integer?,
          ?ended_at: Time?,
          ?failure_reason: String?,
          ?from: Sentdm::Voice::CallParty,
          ?legs: ::Array[Sentdm::Voice::Call::Leg]?,
          ?mode: String,
          ?number: String,
          ?price: Float?,
          ?recording_available: bool,
          ?started_at: Time,
          ?status: String,
          ?timeline: ::Array[Sentdm::Voice::CallTimelineEntry]?,
          ?to: Sentdm::Voice::CallParty
        ) -> void

        def to_hash: -> {
          id: String,
          agent_id: String?,
          answered_at: Time?,
          caller_id_used: String?,
          connected_number: String?,
          direction: String,
          duration_seconds: Integer?,
          ended_at: Time?,
          failure_reason: String?,
          from: Sentdm::Voice::CallParty,
          legs: ::Array[Sentdm::Voice::Call::Leg]?,
          mode: String,
          number: String,
          price: Float?,
          recording_available: bool,
          started_at: Time,
          status: String,
          timeline: ::Array[Sentdm::Voice::CallTimelineEntry]?,
          to: Sentdm::Voice::CallParty
        }

        type leg =
          {
            billed_minutes: Integer,
            cost: Float,
            currency: String,
            direction: String,
            number: String?
          }

        class Leg < Sentdm::Internal::Type::BaseModel
          attr_reader billed_minutes: Integer?

          def billed_minutes=: (Integer) -> Integer

          attr_reader cost: Float?

          def cost=: (Float) -> Float

          attr_reader currency: String?

          def currency=: (String) -> String

          attr_reader direction: String?

          def direction=: (String) -> String

          attr_accessor number: String?

          def initialize: (
            ?billed_minutes: Integer,
            ?cost: Float,
            ?currency: String,
            ?direction: String,
            ?number: String?
          ) -> void

          def to_hash: -> {
            billed_minutes: Integer,
            cost: Float,
            currency: String,
            direction: String,
            number: String?
          }
        end
      end
    end
  end
end
