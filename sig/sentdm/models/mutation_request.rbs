module Sentdm
  module Models
    type mutation_request = { api_key: String, sandbox: bool }

    class MutationRequest < Sentdm::Internal::Type::BaseModel
      attr_reader api_key: String?

      def api_key=: (String) -> String

      attr_reader sandbox: bool?

      def sandbox=: (bool) -> bool

      def initialize: (?api_key: String, ?sandbox: bool) -> void

      def to_hash: -> { api_key: String, sandbox: bool }
    end
  end
end
