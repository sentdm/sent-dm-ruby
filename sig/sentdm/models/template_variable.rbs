module Sentdm
  module Models
    type template_variable =
      {
        name: String,
        props: Sentdm::TemplateVariableProps,
        type: String,
        id: Integer
      }

    class TemplateVariable < Sentdm::Internal::Type::BaseModel
      attr_accessor name: String

      attr_accessor props: Sentdm::TemplateVariableProps

      attr_accessor type: String

      attr_reader id: Integer?

      def id=: (Integer) -> Integer

      def initialize: (
        name: String,
        props: Sentdm::TemplateVariableProps,
        type: String,
        ?id: Integer
      ) -> void

      def to_hash: -> {
        name: String,
        props: Sentdm::TemplateVariableProps,
        type: String,
        id: Integer
      }
    end
  end
end
