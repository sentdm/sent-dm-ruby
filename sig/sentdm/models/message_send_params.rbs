module Sentdm
  module Models
    type message_send_params =
      {
        channel: ::Array[String]?,
        channels: ::Hash[Symbol, ::Array[Sentdm::MessageSendParams::Channel]]?,
        media_urls: ::Array[String]?,
        sandbox: bool,
        scheduled_at: Time?,
        subject: String?,
        template: Sentdm::MessageSendParams::Template?,
        text: String?,
        to: ::Array[String],
        idempotency_key: String,
        x_profile_id: String
      }
      & Sentdm::Internal::Type::request_parameters

    class MessageSendParams < Sentdm::Internal::Type::BaseModel
      extend Sentdm::Internal::Type::RequestParameters::Converter
      include Sentdm::Internal::Type::RequestParameters

      attr_accessor channel: ::Array[String]?

      attr_accessor channels: ::Hash[Symbol, ::Array[Sentdm::MessageSendParams::Channel]]?

      attr_accessor media_urls: ::Array[String]?

      attr_reader sandbox: bool?

      def sandbox=: (bool) -> bool

      attr_accessor scheduled_at: Time?

      attr_accessor subject: String?

      attr_accessor template: Sentdm::MessageSendParams::Template?

      attr_accessor text: String?

      attr_reader to: ::Array[String]?

      def to=: (::Array[String]) -> ::Array[String]

      attr_reader idempotency_key: String?

      def idempotency_key=: (String) -> String

      attr_reader x_profile_id: String?

      def x_profile_id=: (String) -> String

      def initialize: (
        ?channel: ::Array[String]?,
        ?channels: ::Hash[Symbol, ::Array[Sentdm::MessageSendParams::Channel]]?,
        ?media_urls: ::Array[String]?,
        ?sandbox: bool,
        ?scheduled_at: Time?,
        ?subject: String?,
        ?template: Sentdm::MessageSendParams::Template?,
        ?text: String?,
        ?to: ::Array[String],
        ?idempotency_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> void

      def to_hash: -> {
        channel: ::Array[String]?,
        channels: ::Hash[Symbol, ::Array[Sentdm::MessageSendParams::Channel]]?,
        media_urls: ::Array[String]?,
        sandbox: bool,
        scheduled_at: Time?,
        subject: String?,
        template: Sentdm::MessageSendParams::Template?,
        text: String?,
        to: ::Array[String],
        idempotency_key: String,
        x_profile_id: String,
        request_options: Sentdm::RequestOptions
      }

      type channel =
        { country: String?, from: ::Array[String]?, strategy: String? }

      class Channel < Sentdm::Internal::Type::BaseModel
        attr_accessor country: String?

        attr_accessor from: ::Array[String]?

        attr_accessor strategy: String?

        def initialize: (
          ?country: String?,
          ?from: ::Array[String]?,
          ?strategy: String?
        ) -> void

        def to_hash: -> {
          country: String?,
          from: ::Array[String]?,
          strategy: String?
        }
      end

      type template =
        { id: String?, name: String?, parameters: ::Hash[Symbol, String]? }

      class Template < Sentdm::Internal::Type::BaseModel
        attr_accessor id: String?

        attr_accessor name: String?

        attr_accessor parameters: ::Hash[Symbol, String]?

        def initialize: (
          ?id: String?,
          ?name: String?,
          ?parameters: ::Hash[Symbol, String]?
        ) -> void

        def to_hash: -> {
          id: String?,
          name: String?,
          parameters: ::Hash[Symbol, String]?
        }
      end
    end
  end
end
