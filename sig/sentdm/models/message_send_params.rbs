module Sentdm
  module Models
    type message_send_params =
      {
        channel: ::Array[String]?,
        channels: ::Hash[Symbol, ::Array[Sentdm::MessageChannelOptions]]?,
        media_urls: ::Array[String]?,
        sandbox: bool,
        scheduled_at: Time?,
        subject: String?,
        template: Sentdm::TemplateRef?,
        text: String?,
        to: ::Array[String],
        idempotency_key: String,
        x_profile_id: String
      }
      & Sentdm::Internal::Type::request_parameters

    class MessageSendParams < Sentdm::Internal::Type::BaseModel
      extend Sentdm::Internal::Type::RequestParameters::Converter
      include Sentdm::Internal::Type::RequestParameters

      attr_accessor channel: ::Array[String]?

      attr_accessor channels: ::Hash[Symbol, ::Array[Sentdm::MessageChannelOptions]]?

      attr_accessor media_urls: ::Array[String]?

      attr_reader sandbox: bool?

      def sandbox=: (bool) -> bool

      attr_accessor scheduled_at: Time?

      attr_accessor subject: String?

      attr_accessor template: Sentdm::TemplateRef?

      attr_accessor text: String?

      attr_reader to: ::Array[String]?

      def to=: (::Array[String]) -> ::Array[String]

      attr_reader idempotency_key: String?

      def idempotency_key=: (String) -> String

      attr_reader x_profile_id: String?

      def x_profile_id=: (String) -> String

      def initialize: (
        ?channel: ::Array[String]?,
        ?channels: ::Hash[Symbol, ::Array[Sentdm::MessageChannelOptions]]?,
        ?media_urls: ::Array[String]?,
        ?sandbox: bool,
        ?scheduled_at: Time?,
        ?subject: String?,
        ?template: Sentdm::TemplateRef?,
        ?text: String?,
        ?to: ::Array[String],
        ?idempotency_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> void

      def to_hash: -> {
        channel: ::Array[String]?,
        channels: ::Hash[Symbol, ::Array[Sentdm::MessageChannelOptions]]?,
        media_urls: ::Array[String]?,
        sandbox: bool,
        scheduled_at: Time?,
        subject: String?,
        template: Sentdm::TemplateRef?,
        text: String?,
        to: ::Array[String],
        idempotency_key: String,
        x_profile_id: String,
        request_options: Sentdm::RequestOptions
      }
    end
  end
end
