module Sentdm
  module Models
    type account_profile =
      {
        id: String,
        created_at: Time,
        description: String?,
        icon: String?,
        name: String,
        role: String?,
        settings: Sentdm::ProfileSettings,
        short_name: String?,
        status: String?
      }

    class AccountProfile < Sentdm::Internal::Type::BaseModel
      attr_reader id: String?

      def id=: (String) -> String

      attr_reader created_at: Time?

      def created_at=: (Time) -> Time

      attr_accessor description: String?

      attr_accessor icon: String?

      attr_reader name: String?

      def name=: (String) -> String

      attr_accessor role: String?

      attr_reader settings: Sentdm::ProfileSettings?

      def settings=: (Sentdm::ProfileSettings) -> Sentdm::ProfileSettings

      attr_accessor short_name: String?

      attr_accessor status: String?

      def initialize: (
        ?id: String,
        ?created_at: Time,
        ?description: String?,
        ?icon: String?,
        ?name: String,
        ?role: String?,
        ?settings: Sentdm::ProfileSettings,
        ?short_name: String?,
        ?status: String?
      ) -> void

      def to_hash: -> {
        id: String,
        created_at: Time,
        description: String?,
        icon: String?,
        name: String,
        role: String?,
        settings: Sentdm::ProfileSettings,
        short_name: String?,
        status: String?
      }
    end
  end
end
