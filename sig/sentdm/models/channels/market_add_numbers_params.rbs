        attr_accessor campaign_id: String?

        attr_reader sandbox: bool?

        def sandbox=: (bool) -> bool

        attr_reader x_profile_id: String?

        def x_profile_id=: (String) -> String

        def initialize: (
          channel: String,
          country: String,
          type: String,
          numbers: ::Array[Sentdm::Channels::SMSNumberRequest?],
          idempotency_key: String,
          ?campaign_id: String?,
          ?sandbox: bool,
          ?x_profile_id: String,
          ?request_options: Sentdm::request_opts
        ) -> void

        def to_hash: -> {
          channel: String,
          country: String,
          type: String,
          numbers: ::Array[Sentdm::Channels::SMSNumberRequest?],
          idempotency_key: String,
          campaign_id: String?,
