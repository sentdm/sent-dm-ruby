          attr_reader tax_id: String?

          def tax_id=: (String) -> String

          attr_reader tax_id_type: String?

          def tax_id_type=: (String) -> String

          attr_reader website: String?

          def website=: (String) -> String

          def initialize: (
            ?business_name: String,
            ?city: String,
            ?contact_email: String,
            ?contact_name: String,
            ?contact_phone: String,
            ?country: String,
            ?ein_issuing_country: String,
            ?entity_type: Sentdm::Models::Channels::MarketCompliance::Brand::entity_type,
            ?inherit: bool,
            ?legal_name: String,
            ?postal_code: String,
            ?state: String,
            ?street: String,
            ?tax_id: String,
            ?tax_id_type: String,
            ?website: String
          ) -> void

          def to_hash: -> {
            business_name: String,
            city: String,
            contact_email: String,
            contact_name: String,
            contact_phone: String,
            country: String,
            ein_issuing_country: String,
            entity_type: Sentdm::Models::Channels::MarketCompliance::Brand::entity_type,
            inherit: bool,
            legal_name: String,
            postal_code: String,
            state: String,
            street: String,
            tax_id: String,
            tax_id_type: String,
            website: String
          }

          type entity_type =
            :PRIVATE_PROFIT
            | :PUBLIC_PROFIT
            | :NON_PROFIT
            | :SOLE_PROPRIETOR
            | :GOVERNMENT

          module EntityType
            extend Sentdm::Internal::Type::Enum

            PRIVATE_PROFIT: :PRIVATE_PROFIT
            PUBLIC_PROFIT: :PUBLIC_PROFIT
            NON_PROFIT: :NON_PROFIT
            SOLE_PROPRIETOR: :SOLE_PROPRIETOR
            GOVERNMENT: :GOVERNMENT

            def self?.values: -> ::Array[Sentdm::Models::Channels::MarketCompliance::Brand::entity_type]
          end
        end

        type campaign =
