        ) -> Sentdm::Channels::MarketCompliance::Campaign

        def initialize: (
          ?brand: Sentdm::Channels::MarketCompliance::Brand,
          ?campaign: Sentdm::Channels::MarketCompliance::Campaign
        ) -> void

        def to_hash: -> {
          brand: Sentdm::Channels::MarketCompliance::Brand,
          campaign: Sentdm::Channels::MarketCompliance::Campaign
        }

        type brand =
          {
            business_name: String,
            city: String,
            contact_email: String,
            contact_name: String,
            contact_phone: String,
            country: String,
            ein_issuing_country: String,
            entity_type: Sentdm::Models::Channels::MarketCompliance::Brand::entity_type,
            inherit: bool,
            legal_name: String,
            postal_code: String,
            state: String,
            street: String,
            tax_id: String,
            tax_id_type: String,
            website: String
          }

        class Brand < Sentdm::Internal::Type::BaseModel
          attr_reader business_name: String?

          def business_name=: (String) -> String

          attr_reader city: String?

          def city=: (String) -> String

          attr_reader contact_email: String?

          def contact_email=: (String) -> String

          attr_reader contact_name: String?

          def contact_name=: (String) -> String

          attr_reader contact_phone: String?

