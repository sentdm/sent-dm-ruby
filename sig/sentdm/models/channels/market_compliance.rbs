          attr_reader country: String?

          def country=: (String) -> String

          attr_reader ein_issuing_country: String?

          def ein_issuing_country=: (String) -> String

          attr_reader entity_type: Sentdm::Models::Channels::MarketCompliance::Brand::entity_type?

          def entity_type=: (
            Sentdm::Models::Channels::MarketCompliance::Brand::entity_type
          ) -> Sentdm::Models::Channels::MarketCompliance::Brand::entity_type

          attr_reader inherit: bool?

          def inherit=: (bool) -> bool

          attr_reader legal_name: String?

          def legal_name=: (String) -> String

          attr_reader postal_code: String?

