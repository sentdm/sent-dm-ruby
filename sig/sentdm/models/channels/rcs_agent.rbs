module Sentdm
  module Models
    module Channels
      type rcs_agent =
        {
          id: String?,
          agent_use_case: String?,
          brand_color: String?,
          brand_email: String?,
          brand_name: String?,
          brand_phone_number: String?,
          brief_company_description: String?,
          company_ein: String?,
          contact_name_and_title: String?,
          created_at: Time?,
          customer_support_email: String?,
          customer_support_phone_number: String?,
          description: String?,
          display_name: String?,
          entity_type: String?,
          help_message: String?,
          official_address: Sentdm::Channels::RcsAddress?,
          opt_in_process_description: String?,
          phone_number: String?,
          privacy_policy_url: String?,
          reason: String?,
          reason_code: String?,
          sample_messages: ::Array[String]?,
          start_message: String?,
          status: Sentdm::Models::Channels::RcsAgent::status?,
          stop_message: String?,
          terms_and_conditions_url: String?,
          website_url: String?
        }

      class RcsAgent < Sentdm::Internal::Type::BaseModel
        attr_accessor id: String?

        attr_accessor agent_use_case: String?

        attr_accessor brand_color: String?

        attr_accessor brand_email: String?

        attr_accessor brand_name: String?

        attr_accessor brand_phone_number: String?

        attr_accessor brief_company_description: String?

        attr_accessor company_ein: String?

        attr_accessor contact_name_and_title: String?

        attr_accessor created_at: Time?

        attr_accessor customer_support_email: String?

        attr_accessor customer_support_phone_number: String?

        attr_accessor description: String?

        attr_accessor display_name: String?

        attr_accessor entity_type: String?

        attr_accessor help_message: String?

        attr_accessor official_address: Sentdm::Channels::RcsAddress?

        attr_accessor opt_in_process_description: String?

        attr_accessor phone_number: String?

        attr_accessor privacy_policy_url: String?

        attr_accessor reason: String?

        attr_accessor reason_code: String?

        attr_accessor sample_messages: ::Array[String]?

        attr_accessor start_message: String?

        attr_accessor status: Sentdm::Models::Channels::RcsAgent::status?

        attr_accessor stop_message: String?

        attr_accessor terms_and_conditions_url: String?

        attr_accessor website_url: String?

        def initialize: (
          ?id: String?,
          ?agent_use_case: String?,
          ?brand_color: String?,
          ?brand_email: String?,
          ?brand_name: String?,
          ?brand_phone_number: String?,
          ?brief_company_description: String?,
          ?company_ein: String?,
          ?contact_name_and_title: String?,
          ?created_at: Time?,
          ?customer_support_email: String?,
          ?customer_support_phone_number: String?,
          ?description: String?,
          ?display_name: String?,
          ?entity_type: String?,
          ?help_message: String?,
          ?official_address: Sentdm::Channels::RcsAddress?,
          ?opt_in_process_description: String?,
          ?phone_number: String?,
          ?privacy_policy_url: String?,
          ?reason: String?,
          ?reason_code: String?,
          ?sample_messages: ::Array[String]?,
          ?start_message: String?,
          ?status: Sentdm::Models::Channels::RcsAgent::status?,
          ?stop_message: String?,
          ?terms_and_conditions_url: String?,
          ?website_url: String?
        ) -> void

        def to_hash: -> {
          id: String?,
          agent_use_case: String?,
          brand_color: String?,
          brand_email: String?,
          brand_name: String?,
          brand_phone_number: String?,
          brief_company_description: String?,
          company_ein: String?,
          contact_name_and_title: String?,
          created_at: Time?,
          customer_support_email: String?,
          customer_support_phone_number: String?,
          description: String?,
          display_name: String?,
          entity_type: String?,
          help_message: String?,
          official_address: Sentdm::Channels::RcsAddress?,
          opt_in_process_description: String?,
          phone_number: String?,
          privacy_policy_url: String?,
          reason: String?,
          reason_code: String?,
          sample_messages: ::Array[String]?,
          start_message: String?,
          status: Sentdm::Models::Channels::RcsAgent::status?,
          stop_message: String?,
          terms_and_conditions_url: String?,
          website_url: String?
        }

        type status =
          :PROVISIONING | :ACTION_NEEDED | :PENDING_REVIEW | :ACTIVE | :INACTIVE

        module Status
          extend Sentdm::Internal::Type::Enum

          # We are working on it and there is nothing for you to do — a number is being procured, or a registration is being assembled. Minutes to hours.
          PROVISIONING: :PROVISIONING

          # **Waiting on you.** Something the market asks for has not been supplied, a regulator rejected what was, or we have asked you to correct and resubmit your identity data. Nothing progresses until you act. For an SMS market, `GET /v3/channels/sms/{country}/{type}` names what it wants and `PATCH` on the same path supplies it — compliance values, documents and numbers alike.
          ACTION_NEEDED: :ACTION_NEEDED

          # With a regulator or carrier — filed, or assembled and queued for us to file — and their answer is what moves it, to `ACTIVE` or back to `ACTION_NEEDED`. Nothing on your side changes it. Days for SMS, weeks for RCS.
          PENDING_REVIEW: :PENDING_REVIEW

          # Can carry traffic now. A channel a sender profile runs on its organization's reads `ACTIVE` too — it sends, which is what the field is about.
          ACTIVE: :ACTIVE

          # **It had a working sender and no longer does** — the number was released, or the campaign it carried lapsed. Distinct from `PROVISIONING`, which means it has never sent yet: the same absence of a sender, opposite news. Sends will fail until it returns to `ACTIVE`.
          INACTIVE: :INACTIVE

          def self?.values: -> ::Array[Sentdm::Models::Channels::RcsAgent::status]
        end
      end
    end
  end
end
