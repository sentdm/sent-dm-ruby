module Sentdm
  module Models
    module Channels
      type voice_update_params =
        {
          number: String,
          callback_url: String?,
          default_for_app_calls: bool?,
          sandbox: bool,
          status: Sentdm::Models::Channels::VoiceUpdateParams::status?,
          idempotency_key: String,
          x_profile_id: String
        }
        & Sentdm::Internal::Type::request_parameters

      class VoiceUpdateParams < Sentdm::Internal::Type::BaseModel
        extend Sentdm::Internal::Type::RequestParameters::Converter
        include Sentdm::Internal::Type::RequestParameters

        attr_accessor number: String

        attr_accessor callback_url: String?

        attr_accessor default_for_app_calls: bool?

        attr_reader sandbox: bool?

        def sandbox=: (bool) -> bool

        attr_accessor status: Sentdm::Models::Channels::VoiceUpdateParams::status?

        attr_reader idempotency_key: String?

        def idempotency_key=: (String) -> String

        attr_reader x_profile_id: String?

        def x_profile_id=: (String) -> String

        def initialize: (
          number: String,
          ?callback_url: String?,
          ?default_for_app_calls: bool?,
          ?sandbox: bool,
          ?status: Sentdm::Models::Channels::VoiceUpdateParams::status?,
          ?idempotency_key: String,
          ?x_profile_id: String,
          ?request_options: Sentdm::request_opts
        ) -> void

        def to_hash: -> {
          number: String,
          callback_url: String?,
          default_for_app_calls: bool?,
          sandbox: bool,
          status: Sentdm::Models::Channels::VoiceUpdateParams::status?,
          idempotency_key: String,
          x_profile_id: String,
          request_options: Sentdm::RequestOptions
        }

        type status = :ACTIVE | :INACTIVE

        module Status
          extend Sentdm::Internal::Type::Enum

          # Turns calls on for the number again. The callback URL and the signing secret it had are kept; send `callback_url` in the same call to replace the URL.
          ACTIVE: :ACTIVE

          # Turns calls off for the number. Refused while the number is the default line for app calls and other active voice numbers remain; move the default first. The callback URL and the secret stay on the number.
          INACTIVE: :INACTIVE

          def self?.values: -> ::Array[Sentdm::Models::Channels::VoiceUpdateParams::status]
        end
      end
    end
  end
end
