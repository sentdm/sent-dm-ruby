module Sentdm
  module Models
    module Channels
      type sms_create_params =
        {
          number_type: Sentdm::Models::Channels::SMSCreateParams::number_type,
          area_codes: ::Array[String]?,
          compliance: Sentdm::Channels::MarketCompliance,
          country: String,
          numbers: ::Array[Sentdm::Channels::SMSNumberRequest]?,
          sandbox: bool,
          sender_value: String?,
          idempotency_key: String,
          x_profile_id: String
        }
        & Sentdm::Internal::Type::request_parameters

      class SMSCreateParams < Sentdm::Internal::Type::BaseModel
        extend Sentdm::Internal::Type::RequestParameters::Converter
        include Sentdm::Internal::Type::RequestParameters

        attr_accessor number_type: Sentdm::Models::Channels::SMSCreateParams::number_type

        attr_accessor area_codes: ::Array[String]?

        attr_reader compliance: Sentdm::Channels::MarketCompliance?

        def compliance=: (
          Sentdm::Channels::MarketCompliance
        ) -> Sentdm::Channels::MarketCompliance

        attr_reader country: String?

        def country=: (String) -> String

        attr_accessor numbers: ::Array[Sentdm::Channels::SMSNumberRequest]?

        attr_reader sandbox: bool?

        def sandbox=: (bool) -> bool

        attr_accessor sender_value: String?

        attr_reader idempotency_key: String?

        def idempotency_key=: (String) -> String

        attr_reader x_profile_id: String?

        def x_profile_id=: (String) -> String

        def initialize: (
          number_type: Sentdm::Models::Channels::SMSCreateParams::number_type,
          ?area_codes: ::Array[String]?,
          ?compliance: Sentdm::Channels::MarketCompliance,
          ?country: String,
          ?numbers: ::Array[Sentdm::Channels::SMSNumberRequest]?,
          ?sandbox: bool,
          ?sender_value: String?,
          ?idempotency_key: String,
          ?x_profile_id: String,
          ?request_options: Sentdm::request_opts
        ) -> void

        def to_hash: -> {
          number_type: Sentdm::Models::Channels::SMSCreateParams::number_type,
          area_codes: ::Array[String]?,
          compliance: Sentdm::Channels::MarketCompliance,
          country: String,
          numbers: ::Array[Sentdm::Channels::SMSNumberRequest]?,
          sandbox: bool,
          sender_value: String?,
          idempotency_key: String,
          x_profile_id: String,
          request_options: Sentdm::RequestOptions
        }

        type number_type =
          :LOCAL
          | :TOLL_FREE
          | :SHORT_CODE
          | :ALPHANUMERIC
          | :TEN_DLC
          | :MOBILE
          | :"10DLC"

        module NumberType
          extend Sentdm::Internal::Type::Enum

          # A geographic number for the country. The ordinary choice: recognisable to recipients, and available almost everywhere.
          LOCAL: :LOCAL

          # A toll-free number. High throughput and no per-country registration, but US toll-free traffic goes through its own verification.
          TOLL_FREE: :TOLL_FREE

          # A short code — five or six digits, leased rather than provisioned. Highest throughput, longest lead time, and the most expensive.
          SHORT_CODE: :SHORT_CODE

          # A sender name rather than a number, up to 11 characters. Recipients cannot reply. Not available in every country, and several require it to be pre-registered with documents.
          ALPHANUMERIC: :ALPHANUMERIC

          # A US 10-digit long code registered with The Campaign Registry. The only sender type that registers with a compliance regime, so it is the only one whose market declares `compliance.brand` and `compliance.campaign`.
          TEN_DLC: :TEN_DLC

          # A mobile number. Where a country distinguishes it from a landline, some carriers treat mobile traffic differently.
          MOBILE: :MOBILE

          # The industry's spelling of `TEN_DLC`, accepted so an integrator can send the term it knows. Resolves to the same market.
          NUMBER_TYPE_10_DLC: :"10DLC"

          def self?.values: -> ::Array[Sentdm::Models::Channels::SMSCreateParams::number_type]
        end
      end
    end
  end
end
