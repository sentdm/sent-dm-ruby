module Sentdm
  module Models
    module Channels
      type market_list_numbers_params =
        {
          channel: String,
          country: String,
          type: String,
          campaign_id: String?,
          x_profile_id: String
        }
        & Sentdm::Internal::Type::request_parameters

      class MarketListNumbersParams < Sentdm::Internal::Type::BaseModel
        extend Sentdm::Internal::Type::RequestParameters::Converter
        include Sentdm::Internal::Type::RequestParameters

        attr_accessor channel: String

        attr_accessor country: String

        attr_accessor type: String

        attr_accessor campaign_id: String?

        attr_reader x_profile_id: String?

        def x_profile_id=: (String) -> String

        def initialize: (
          channel: String,
          country: String,
          type: String,
          ?campaign_id: String?,
          ?x_profile_id: String,
          ?request_options: Sentdm::request_opts
        ) -> void

        def to_hash: -> {
          channel: String,
          country: String,
          type: String,
          campaign_id: String?,
          x_profile_id: String,
          request_options: Sentdm::RequestOptions
        }
      end
    end
  end
end
