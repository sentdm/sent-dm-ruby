module Sentdm
  module Models
    module Calls
      type participant_update_params =
        {
          id: String,
          participant_id: String,
          muted: bool,
          sandbox: bool,
          idempotency_key: String,
          x_profile_id: String
        }
        & Sentdm::Internal::Type::request_parameters

      class ParticipantUpdateParams < Sentdm::Internal::Type::BaseModel
        extend Sentdm::Internal::Type::RequestParameters::Converter
        include Sentdm::Internal::Type::RequestParameters

        attr_accessor id: String

        attr_accessor participant_id: String

        attr_reader muted: bool?

        def muted=: (bool) -> bool

        attr_reader sandbox: bool?

        def sandbox=: (bool) -> bool

        attr_reader idempotency_key: String?

        def idempotency_key=: (String) -> String

        attr_reader x_profile_id: String?

        def x_profile_id=: (String) -> String

        def initialize: (
          id: String,
          participant_id: String,
          ?muted: bool,
          ?sandbox: bool,
          ?idempotency_key: String,
          ?x_profile_id: String,
          ?request_options: Sentdm::request_opts
        ) -> void

        def to_hash: -> {
          id: String,
          participant_id: String,
          muted: bool,
          sandbox: bool,
          idempotency_key: String,
          x_profile_id: String,
          request_options: Sentdm::RequestOptions
        }
      end
    end
  end
end
