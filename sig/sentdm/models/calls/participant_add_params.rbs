module Sentdm
  module Models
    module Calls
      type participant_add_params =
        {
          id: String,
          caller_id: String?,
          sandbox: bool,
          to: Sentdm::Calls::CallParticipantTarget,
          idempotency_key: String,
          x_profile_id: String
        }
        & Sentdm::Internal::Type::request_parameters

      class ParticipantAddParams < Sentdm::Internal::Type::BaseModel
        extend Sentdm::Internal::Type::RequestParameters::Converter
        include Sentdm::Internal::Type::RequestParameters

        attr_accessor id: String

        attr_accessor caller_id: String?

        attr_reader sandbox: bool?

        def sandbox=: (bool) -> bool

        attr_reader to: Sentdm::Calls::CallParticipantTarget?

        def to=: (
          Sentdm::Calls::CallParticipantTarget
        ) -> Sentdm::Calls::CallParticipantTarget

        attr_reader idempotency_key: String?

        def idempotency_key=: (String) -> String

        attr_reader x_profile_id: String?

        def x_profile_id=: (String) -> String

        def initialize: (
          id: String,
          ?caller_id: String?,
          ?sandbox: bool,
          ?to: Sentdm::Calls::CallParticipantTarget,
          ?idempotency_key: String,
          ?x_profile_id: String,
          ?request_options: Sentdm::request_opts
        ) -> void

        def to_hash: -> {
          id: String,
          caller_id: String?,
          sandbox: bool,
          to: Sentdm::Calls::CallParticipantTarget,
          idempotency_key: String,
          x_profile_id: String,
          request_options: Sentdm::RequestOptions
        }
      end
    end
  end
end
