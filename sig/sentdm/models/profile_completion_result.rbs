module Sentdm
  module Models
    type profile_completion_result = { message: String, status: String }

    class ProfileCompletionResult < Sentdm::Internal::Type::BaseModel
      attr_reader message: String?

      def message=: (String) -> String

      attr_reader status: String?

      def status=: (String) -> String

      def initialize: (?message: String, ?status: String) -> void

      def to_hash: -> { message: String, status: String }
    end
  end
end
