module Sentdm
  module Models
    type channels_state =
      {
        customer_id: String?,
        mms: ::Array[Sentdm::MmsMarket],
        rcs: Sentdm::Channels::RcsAgent?,
        sms: ::Array[Sentdm::ChannelsState::SMS],
        voice: ::Array[Sentdm::Channels::VoiceNumber],
        whatsapp: Sentdm::Channels::WhatsappChannel?
      }

    class ChannelsState < Sentdm::Internal::Type::BaseModel
      attr_accessor customer_id: String?

      attr_reader mms: ::Array[Sentdm::MmsMarket]?

      def mms=: (::Array[Sentdm::MmsMarket]) -> ::Array[Sentdm::MmsMarket]

      attr_accessor rcs: Sentdm::Channels::RcsAgent?

      attr_reader sms: ::Array[Sentdm::ChannelsState::SMS]?

      def sms=: (
        ::Array[Sentdm::ChannelsState::SMS]
      ) -> ::Array[Sentdm::ChannelsState::SMS]

      attr_reader voice: ::Array[Sentdm::Channels::VoiceNumber]?

      def voice=: (
        ::Array[Sentdm::Channels::VoiceNumber]
      ) -> ::Array[Sentdm::Channels::VoiceNumber]

      attr_accessor whatsapp: Sentdm::Channels::WhatsappChannel?

      def initialize: (
        ?customer_id: String?,
        ?mms: ::Array[Sentdm::MmsMarket],
        ?rcs: Sentdm::Channels::RcsAgent?,
        ?sms: ::Array[Sentdm::ChannelsState::SMS],
        ?voice: ::Array[Sentdm::Channels::VoiceNumber],
        ?whatsapp: Sentdm::Channels::WhatsappChannel?
      ) -> void

      def to_hash: -> {
        customer_id: String?,
        mms: ::Array[Sentdm::MmsMarket],
        rcs: Sentdm::Channels::RcsAgent?,
        sms: ::Array[Sentdm::ChannelsState::SMS],
        voice: ::Array[Sentdm::Channels::VoiceNumber],
        whatsapp: Sentdm::Channels::WhatsappChannel?
      }

      type sms =
        {
          compliance: Sentdm::Channels::SuppliedCompliance?,
          country: String?,
          number_type: String?,
          numbers: ::Array[Sentdm::Channels::SMSNumber],
          reason: String?,
          reason_code: String?,
          status: Sentdm::Models::ChannelsState::SMS::status?
        }

      class SMS < Sentdm::Internal::Type::BaseModel
        attr_accessor compliance: Sentdm::Channels::SuppliedCompliance?

        attr_accessor country: String?

        attr_accessor number_type: String?

        attr_reader numbers: ::Array[Sentdm::Channels::SMSNumber]?

        def numbers=: (
          ::Array[Sentdm::Channels::SMSNumber]
        ) -> ::Array[Sentdm::Channels::SMSNumber]

        attr_accessor reason: String?

        attr_accessor reason_code: String?

        attr_accessor status: Sentdm::Models::ChannelsState::SMS::status?

        def initialize: (
          ?compliance: Sentdm::Channels::SuppliedCompliance?,
          ?country: String?,
          ?number_type: String?,
          ?numbers: ::Array[Sentdm::Channels::SMSNumber],
          ?reason: String?,
          ?reason_code: String?,
          ?status: Sentdm::Models::ChannelsState::SMS::status?
        ) -> void

        def to_hash: -> {
          compliance: Sentdm::Channels::SuppliedCompliance?,
          country: String?,
          number_type: String?,
          numbers: ::Array[Sentdm::Channels::SMSNumber],
          reason: String?,
          reason_code: String?,
          status: Sentdm::Models::ChannelsState::SMS::status?
        }

        type status =
          :PROVISIONING | :ACTION_NEEDED | :PENDING_REVIEW | :ACTIVE | :INACTIVE

        module Status
          extend Sentdm::Internal::Type::Enum

          # We are working on it and there is nothing for you to do — a number is being procured, or a registration is being assembled. Minutes to hours.
          PROVISIONING: :PROVISIONING

          # **Waiting on you.** Something the market asks for has not been supplied, a regulator rejected what was, or we have asked you to correct and resubmit your identity data. Nothing progresses until you act. For an SMS market, `GET /v3/channels/sms/{country}/{type}` names what it wants and `PATCH` on the same path supplies it — compliance values, documents and numbers alike.
          ACTION_NEEDED: :ACTION_NEEDED

          # With a regulator or carrier — filed, or assembled and queued for us to file — and their answer is what moves it, to `ACTIVE` or back to `ACTION_NEEDED`. Nothing on your side changes it. Days for SMS, weeks for RCS.
          PENDING_REVIEW: :PENDING_REVIEW

          # Can carry traffic now. A channel a sender profile runs on its organization's reads `ACTIVE` too — it sends, which is what the field is about.
          ACTIVE: :ACTIVE

          # **It had a working sender and no longer does** — the number was released, or the campaign it carried lapsed. Distinct from `PROVISIONING`, which means it has never sent yet: the same absence of a sender, opposite news. Sends will fail until it returns to `ACTIVE`.
          INACTIVE: :INACTIVE

          def self?.values: -> ::Array[Sentdm::Models::ChannelsState::SMS::status]
        end
      end
    end
  end
end
