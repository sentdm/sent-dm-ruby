module Sentdm
  module Models
    type call_list_params =
      {
        direction: String?,
        from: Time?,
        number: String?,
        page: Integer,
        page_size: Integer,
        status: String?,
        to: Time?,
        x_profile_id: String
      }
      & Sentdm::Internal::Type::request_parameters

    class CallListParams < Sentdm::Internal::Type::BaseModel
      extend Sentdm::Internal::Type::RequestParameters::Converter
      include Sentdm::Internal::Type::RequestParameters

      attr_accessor direction: String?

      attr_accessor from: Time?

      attr_accessor number: String?

      attr_reader page: Integer?

      def page=: (Integer) -> Integer

      attr_reader page_size: Integer?

      def page_size=: (Integer) -> Integer

      attr_accessor status: String?

      attr_accessor to: Time?

      attr_reader x_profile_id: String?

      def x_profile_id=: (String) -> String

      def initialize: (
        ?direction: String?,
        ?from: Time?,
        ?number: String?,
        ?page: Integer,
        ?page_size: Integer,
        ?status: String?,
        ?to: Time?,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> void

      def to_hash: -> {
        direction: String?,
        from: Time?,
        number: String?,
        page: Integer,
        page_size: Integer,
        status: String?,
        to: Time?,
        x_profile_id: String,
        request_options: Sentdm::RequestOptions
      }
    end
  end
end
