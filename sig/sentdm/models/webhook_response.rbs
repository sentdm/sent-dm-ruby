module Sentdm
  module Models
    type webhook_response =
      {
        id: String,
        consecutive_failures: Integer,
        created_at: Time,
        customer_id: String,
        display_name: String,
        endpoint_url: String,
        event_filters: ::Hash[Symbol, ::Array[String]]?,
        event_types: ::Array[String],
        is_active: bool,
        is_inheritable: bool,
        last_delivery_attempt_at: Time?,
        last_successful_delivery_at: Time?,
        retry_count: Integer,
        sender_profile: Sentdm::WebhookResponse::SenderProfile?,
        signing_secret: String?,
        timeout_seconds: Integer,
        updated_at: Time?,
        webhook_version: Integer
      }

    class WebhookResponse < Sentdm::Internal::Type::BaseModel
      attr_reader id: String?

      def id=: (String) -> String

      attr_reader consecutive_failures: Integer?

      def consecutive_failures=: (Integer) -> Integer

      attr_reader created_at: Time?

      def created_at=: (Time) -> Time

      attr_reader customer_id: String?

      def customer_id=: (String) -> String

      attr_reader display_name: String?

      def display_name=: (String) -> String

      attr_reader endpoint_url: String?

      def endpoint_url=: (String) -> String

      attr_accessor event_filters: ::Hash[Symbol, ::Array[String]]?

      attr_reader event_types: ::Array[String]?

      def event_types=: (::Array[String]) -> ::Array[String]

      attr_reader is_active: bool?

      def is_active=: (bool) -> bool

      attr_reader is_inheritable: bool?

      def is_inheritable=: (bool) -> bool

      attr_accessor last_delivery_attempt_at: Time?

      attr_accessor last_successful_delivery_at: Time?

      attr_reader retry_count: Integer?

      def retry_count=: (Integer) -> Integer

      attr_accessor sender_profile: Sentdm::WebhookResponse::SenderProfile?

      attr_accessor signing_secret: String?

      attr_reader timeout_seconds: Integer?

      def timeout_seconds=: (Integer) -> Integer

      attr_accessor updated_at: Time?

      attr_reader webhook_version: Integer?

      def webhook_version=: (Integer) -> Integer

      def initialize: (
        ?id: String,
        ?consecutive_failures: Integer,
        ?created_at: Time,
        ?customer_id: String,
        ?display_name: String,
        ?endpoint_url: String,
        ?event_filters: ::Hash[Symbol, ::Array[String]]?,
        ?event_types: ::Array[String],
        ?is_active: bool,
        ?is_inheritable: bool,
        ?last_delivery_attempt_at: Time?,
        ?last_successful_delivery_at: Time?,
        ?retry_count: Integer,
        ?sender_profile: Sentdm::WebhookResponse::SenderProfile?,
        ?signing_secret: String?,
        ?timeout_seconds: Integer,
        ?updated_at: Time?,
        ?webhook_version: Integer
      ) -> void

      def to_hash: -> {
        id: String,
        consecutive_failures: Integer,
        created_at: Time,
        customer_id: String,
        display_name: String,
        endpoint_url: String,
        event_filters: ::Hash[Symbol, ::Array[String]]?,
        event_types: ::Array[String],
        is_active: bool,
        is_inheritable: bool,
        last_delivery_attempt_at: Time?,
        last_successful_delivery_at: Time?,
        retry_count: Integer,
        sender_profile: Sentdm::WebhookResponse::SenderProfile?,
        signing_secret: String?,
        timeout_seconds: Integer,
        updated_at: Time?,
        webhook_version: Integer
      }

      type sender_profile =
        {
          event_filters: ::Hash[Symbol, ::Array[String]]?,
          event_types: ::Array[String]
        }

      class SenderProfile < Sentdm::Internal::Type::BaseModel
        attr_accessor event_filters: ::Hash[Symbol, ::Array[String]]?

        attr_reader event_types: ::Array[String]?

        def event_types=: (::Array[String]) -> ::Array[String]

        def initialize: (
          ?event_filters: ::Hash[Symbol, ::Array[String]]?,
          ?event_types: ::Array[String]
        ) -> void

        def to_hash: -> {
          event_filters: ::Hash[Symbol, ::Array[String]]?,
          event_types: ::Array[String]
        }
      end
    end
  end
end
