module Sentdm
  module Models
    type pagination_cursors = { after: String?, before: String? }

    class PaginationCursors < Sentdm::Internal::Type::BaseModel
      attr_accessor after: String?

      attr_accessor before: String?

      def initialize: (?after: String?, ?before: String?) -> void

      def to_hash: -> { after: String?, before: String? }
    end
  end
end
