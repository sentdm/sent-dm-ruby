module Sentdm
  module Models
    type pagination_meta =
      {
        cursors: Sentdm::PaginationCursors?,
        has_more: bool,
        page: Integer,
        page_size: Integer,
        total_count: Integer,
        total_pages: Integer
      }

    class PaginationMeta < Sentdm::Internal::Type::BaseModel
      attr_accessor cursors: Sentdm::PaginationCursors?

      attr_reader has_more: bool?

      def has_more=: (bool) -> bool

      attr_reader page: Integer?

      def page=: (Integer) -> Integer

      attr_reader page_size: Integer?

      def page_size=: (Integer) -> Integer

      attr_reader total_count: Integer?

      def total_count=: (Integer) -> Integer

      attr_reader total_pages: Integer?

      def total_pages=: (Integer) -> Integer

      def initialize: (
        ?cursors: Sentdm::PaginationCursors?,
        ?has_more: bool,
        ?page: Integer,
        ?page_size: Integer,
        ?total_count: Integer,
        ?total_pages: Integer
      ) -> void

      def to_hash: -> {
        cursors: Sentdm::PaginationCursors?,
        has_more: bool,
        page: Integer,
        page_size: Integer,
        total_count: Integer,
        total_pages: Integer
      }
    end
  end
end
