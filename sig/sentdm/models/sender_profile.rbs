module Sentdm
  module Models
    type sender_profile =
      {
        id: String,
        api_key: String?,
        billing: Sentdm::SenderProfileBilling?,
        channels: Sentdm::ChannelsState?,
        compliance: Sentdm::SenderProfile::Compliance?,
        created_at: Time,
        description: String?,
        name: String,
        notifications: String?,
        organization_id: String?,
        short_name: String?
      }

    class SenderProfile < Sentdm::Internal::Type::BaseModel
      attr_reader id: String?

      def id=: (String) -> String

      attr_accessor api_key: String?

      attr_accessor billing: Sentdm::SenderProfileBilling?

      attr_accessor channels: Sentdm::ChannelsState?

      attr_accessor compliance: Sentdm::SenderProfile::Compliance?

      attr_reader created_at: Time?

      def created_at=: (Time) -> Time

      attr_accessor description: String?

      attr_reader name: String?

      def name=: (String) -> String

      attr_accessor notifications: String?

      attr_accessor organization_id: String?

      attr_accessor short_name: String?

      def initialize: (
        ?id: String,
        ?api_key: String?,
        ?billing: Sentdm::SenderProfileBilling?,
        ?channels: Sentdm::ChannelsState?,
        ?compliance: Sentdm::SenderProfile::Compliance?,
        ?created_at: Time,
        ?description: String?,
        ?name: String,
        ?notifications: String?,
        ?organization_id: String?,
        ?short_name: String?
      ) -> void

      def to_hash: -> {
        id: String,
        api_key: String?,
        billing: Sentdm::SenderProfileBilling?,
        channels: Sentdm::ChannelsState?,
        compliance: Sentdm::SenderProfile::Compliance?,
        created_at: Time,
        description: String?,
        name: String,
        notifications: String?,
        organization_id: String?,
        short_name: String?
      }

      type compliance =
        {
          brand: ::Hash[Symbol, top]?,
          campaign: ::Hash[Symbol, top]?,
          documents: ::Array[Sentdm::SenderProfile::Compliance::Document]?
        }

      class Compliance < Sentdm::Internal::Type::BaseModel
        attr_accessor brand: ::Hash[Symbol, top]?

        attr_accessor campaign: ::Hash[Symbol, top]?

        attr_accessor documents: ::Array[Sentdm::SenderProfile::Compliance::Document]?

        def initialize: (
          ?brand: ::Hash[Symbol, top]?,
          ?campaign: ::Hash[Symbol, top]?,
          ?documents: ::Array[Sentdm::SenderProfile::Compliance::Document]?
        ) -> void

        def to_hash: -> {
          brand: ::Hash[Symbol, top]?,
          campaign: ::Hash[Symbol, top]?,
          documents: ::Array[Sentdm::SenderProfile::Compliance::Document]?
        }

        type document =
          { document_id: String?, file_name: String?, key: String }

        class Document < Sentdm::Internal::Type::BaseModel
          attr_accessor document_id: String?

          attr_accessor file_name: String?

          attr_reader key: String?

          def key=: (String) -> String

          def initialize: (
            ?document_id: String?,
            ?file_name: String?,
            ?key: String
          ) -> void

          def to_hash: -> {
            document_id: String?,
            file_name: String?,
            key: String
          }
        end
      end
    end
  end
end
