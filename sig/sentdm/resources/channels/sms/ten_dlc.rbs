            ?sandbox: bool,
            ?idempotency_key: String,
            ?x_profile_id: String,
            ?request_options: Sentdm::request_opts
          ) -> Sentdm::Channels::APIResponseOfSMSMarket

          def add_numbers: (
            campaign_id: String,
            numbers: ::Array[Sentdm::Channels::SMSNumberRequest?],
            ?sandbox: bool,
            ?idempotency_key: String,
            ?x_profile_id: String,
            ?request_options: Sentdm::request_opts
          ) -> Sentdm::Channels::APIResponseOfSMSMarket

          def retrieve_compliance: (
            ?x_profile_id: String,
            ?request_options: Sentdm::request_opts
