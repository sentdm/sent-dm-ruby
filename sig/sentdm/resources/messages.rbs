module Sentdm
  module Resources
    class Messages
      def cancel: (
        String id,
        ?sandbox: bool,
        ?idempotency_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::APIResponseOfCancelledMessage

      def resend: (
        String id,
        ?sandbox: bool,
        ?idempotency_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::MessageSendResponse

      def retrieve_activities: (
        String id,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::APIResponseOfMessageActivities

      def retrieve_status: (
        String id,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::APIResponseOfMessage

      def send_: (
        ?channel: ::Array[String]?,
        ?channels: ::Hash[Symbol, ::Array[Sentdm::MessageChannelOptions]]?,
        ?media_urls: ::Array[String]?,
        ?sandbox: bool,
        ?scheduled_at: Time?,
        ?subject: String?,
        ?template: Sentdm::TemplateRef?,
        ?text: String?,
        ?to: ::Array[String],
        ?idempotency_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::MessageSendResponse

      def initialize: (client: Sentdm::Client) -> void
    end
  end
end
