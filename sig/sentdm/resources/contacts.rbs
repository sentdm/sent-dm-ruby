module Sentdm
  module Resources
    class Contacts
      def create: (
        phone_number: String,
        ?sandbox: bool,
        ?idempotency_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::APIResponseOfContact

      def retrieve: (
        String id,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::APIResponseOfContact

      def update: (
        String id,
        ?default_channel: String?,
        ?opt_out: bool?,
        ?sandbox: bool,
        ?idempotency_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::APIResponseOfContact

      def list: (
        ?channel: String?,
        ?page: Integer,
        ?page_size: Integer,
        ?phone: String?,
        ?search: String?,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::Internal::ContactsPage[Sentdm::ContactResponse]

      def delete: (
        String id,
        ?sandbox: bool,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> nil

      def retrieve_message_summary: (
        String contact_id,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::APIResponseOfContactMessageSummary

      def initialize: (client: Sentdm::Client) -> void
    end
  end
end
