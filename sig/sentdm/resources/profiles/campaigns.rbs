module Sentdm
  module Resources
    class Profiles
      class Campaigns
        def create: (
          String profile_id,
          campaign: Sentdm::Profiles::CampaignData,
          ?sandbox: bool,
          ?idempotency_key: String,
          ?x_profile_id: String,
          ?request_options: Sentdm::request_opts
        ) -> Sentdm::Profiles::APIResponseOfBrandCampaign

        def update: (
          String campaign_id,
          profile_id: String,
          campaign: Sentdm::Profiles::CampaignData,
          ?sandbox: bool,
          ?idempotency_key: String,
          ?x_profile_id: String,
          ?request_options: Sentdm::request_opts
        ) -> Sentdm::Profiles::APIResponseOfBrandCampaign

        def list: (
          String profile_id,
          ?x_profile_id: String,
          ?request_options: Sentdm::request_opts
        ) -> Sentdm::Profiles::APIResponseOfListOfBrandCampaign

        def delete: (
          String campaign_id,
          profile_id: String,
          ?sandbox: bool,
          ?x_profile_id: String,
          ?request_options: Sentdm::request_opts
        ) -> nil

        def initialize: (client: Sentdm::Client) -> void
      end
    end
  end
end
