module Sentdm
  module Resources
    class Webhooks
      def create: (
        ?api_key: String,
        ?display_name: String,
        ?endpoint_url: String,
        ?event_filters: ::Hash[Symbol, ::Array[String]]?,
        ?event_types: ::Array[String],
        ?retry_count: Integer,
        ?sandbox: bool,
        ?sender_profile: Sentdm::WebhookCreateParams::SenderProfile?,
        ?timeout_seconds: Integer,
        ?idempotency_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::APIResponseWebhook

      def retrieve: (
        String id,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::APIResponseWebhook

      def update: (
        String id,
        ?api_key: String,
        ?display_name: String,
        ?endpoint_url: String,
        ?event_filters: ::Hash[Symbol, ::Array[String]]?,
        ?event_types: ::Array[String],
        ?retry_count: Integer,
        ?sandbox: bool,
        ?sender_profile: Sentdm::WebhookUpdateParams::SenderProfile?,
        ?timeout_seconds: Integer,
        ?idempotency_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::APIResponseWebhook

      def list: (
        ?is_active: bool?,
        ?page: Integer,
        ?page_size: Integer,
        ?search: String?,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::Internal::WebhooksPage[Sentdm::WebhookResponse]

      def delete: (
        String id,
        ?api_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> nil

      def list_event_types: (
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::Models::WebhookListEventTypesResponse

      def list_events: (
        String id,
        ?page: Integer,
        ?page_size: Integer,
        ?search: String?,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::Internal::WebhookEventsPage[Sentdm::Models::WebhookListEventsResponse]

      def rotate_secret: (
        String id,
        ?api_key: String,
        ?sandbox: bool,
        ?idempotency_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::Models::WebhookRotateSecretResponse

      def test_: (
        String id,
        ?api_key: String,
        ?event_type: String,
        ?sandbox: bool,
        ?idempotency_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::Models::WebhookTestResponse

      def toggle_status: (
        String id,
        ?api_key: String,
        ?is_active: bool,
        ?sandbox: bool,
        ?idempotency_key: String,
        ?x_profile_id: String,
        ?request_options: Sentdm::request_opts
      ) -> Sentdm::APIResponseWebhook

      def initialize: (client: Sentdm::Client) -> void
    end
  end
end
